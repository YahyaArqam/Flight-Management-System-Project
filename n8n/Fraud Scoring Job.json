        {
            "parameters": {
                "jsCode": "// Get all flight items from this node's input\nconst items = $input.all();\n\n// Get booking data from earlier node\nconst bookings = $('Get Recent Bookings').all();\n\n// Build enriched list combining booking + flight data\nconst enriched = items.map(item => {\n  const flight = item.json;\n  \n  const booking = bookings.find(\n    b => b.json.flight_id === flight.id\n  );\n\n  return {\n    booking_id: booking?.json.id,\n    passenger_id: booking?.json.passenger_id,\n    flight_id: flight.id,\n    flight_number: flight.flight_number,\n    departure_time: flight.departure_time,\n    arrival_time: flight.arrival_time,\n  };\n});\n\n// Group by passenger_id\nconst byPassenger = {};\nfor (const entry of enriched) {\n  const pid = entry.passenger_id;\n  if (!byPassenger[pid]) byPassenger[pid] = [];\n  byPassenger[pid].push(entry);\n}\n\n// Find passengers with overlapping flights\nconst fraudCases = [];\n\nfor (const [passenger_id, flights] of Object.entries(byPassenger)) {\n  if (flights.length < 2) continue;\n\n  for (let i = 0; i < flights.length; i++) {\n    for (let j = i + 1; j < flights.length; j++) {\n      const a = flights[i];\n      const b = flights[j];\n\n      const depA = new Date(a.departure_time);\n      const arrA = new Date(a.arrival_time);\n      const depB = new Date(b.departure_time);\n      const arrB = new Date(b.arrival_time);\n\n      // Overlap = one departs before the other arrives\n      const overlaps = depA < arrB && depB < arrA;\n\n      if (overlaps) {\n        fraudCases.push({\n          passenger_id,\n          booking_1: a.booking_id,\n          flight_1: a.flight_number,\n          departure_1: a.departure_time,\n          arrival_1: a.arrival_time,\n          booking_2: b.booking_id,\n          flight_2: b.flight_number,\n          departure_2: b.departure_time,\n          arrival_2: b.arrival_time,\n        });\n      }\n    }\n  }\n}\n\n// If no fraud cases return a flag\nif (fraudCases.length === 0) {\n  return [{ json: { fraud_found: false } }];\n}\n\n// Return each fraud case as separate item\nreturn fraudCases.map(c => ({ json: { fraud_found: true, ...c } }));"
            },
