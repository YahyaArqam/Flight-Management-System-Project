        {
            "parameters": {
                "jsCode": "// Get passenger question from webhook\nconst question = $('Support Ticket Webhook').item.json.body.question;\n\n// Get passenger booking fare type\n// CRITICAL: use actual fare type not generic\nconst bookings = $('Get Passenger Booking').all();\nconst fareType = bookings.length > 0 \n  ? bookings[0].json.fare_type \n  : 'UNKNOWN';\n\n// Get passenger name\nconst passengers = $('Get Passenger Details').all();\nconst passengerName = passengers.length > 0\n  ? `${passengers[0].json.first_name} ${passengers[0].json.last_name}`\n  : 'Passenger';\n\n// Get relevant policy chunks from Pinecone\nconst matches = $json.matches || [];\nconst policyChunks = matches\n  .map(m => m.metadata?.text || '')\n  .filter(t => t.length > 0)\n  .join('\\n\\n');\n\n// Build fare-aware prompt\n// CRITICAL: inject actual fare type so AI responds\n// based on passenger real rules not generic policy\nconst prompt = `You are a helpful airline customer support agent.\n\nPASSENGER INFORMATION:\nName: ${passengerName}\nFare Type: ${fareType}\n\nRELEVANT POLICY INFORMATION:\n${policyChunks}\n\nIMPORTANT: Your response must be specific to the passenger's \n${fareType} fare type. Do not give generic answers.\nFor example:\n- BASIC_ECONOMY passengers cannot change dates or get refunds\n- FLEXIBLE passengers can change dates for free\n- BUSINESS_CLASS passengers have unlimited free changes\n\nCUSTOMER QUESTION:\n${question}\n\nPlease provide a helpful, accurate response based on the \npassenger's actual ${fareType} fare rules.`;\n\nreturn [{\n  json: {\n    prompt,\n    question,\n    fareType,\n    passengerName\n  }\n}];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1024,
                96
            ],
            "id": "094e49a9-e792-44a8-911a-b9c31a012a2f",
            "name": "Build Fare Aware Prompt"
