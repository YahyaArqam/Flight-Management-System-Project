            "name": "Get Flight Bookings",
            "alwaysOutputData": true
        },
        {
            "parameters": {
                "jsCode": "const flights = $('Get All Flights').all();\nconst bookings = $('Get Flight Bookings').all();\n\nconst stats = flights.map(flight => {\n  const flightBookings = bookings.filter(b => \n    b.json.flight_id === flight.json.id\n  );\n  \n  const totalRevenue = flightBookings.reduce((sum, b) => {\n    return sum + (b.json.price_paid || 0);\n  }, 0);\n\n  const bookedSeats = flightBookings.length;\n  const loadFactor = ((bookedSeats / flight.json.total_capacity) * 100).toFixed(1);\n\n  return {\n    json: {\n      flight_number: flight.json.flight_number,\n      origin: flight.json.origin,\n      destination: flight.json.destination,\n      departure_time: flight.json.departure_time,\n      total_capacity: flight.json.total_capacity,\n      booked_seats: bookedSeats,\n      load_factor: loadFactor + '%',\n      total_revenue: '$' + totalRevenue.toFixed(2)\n    }\n  };\n});\n\nreturn stats;"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                672,
                0
            ],
            "id": "ed9e26ca-821e-415a-8663-ef8706d83791",
            "name": "Calculate Flight Stats"
        },
        {
            "parameters": {
                "jsCode": "const flights = $input.all();\n\nlet tableRows = '';\nflights.forEach(f => {\n  tableRows += `\nFlight:     ${f.json.flight_number}\nRoute:      ${f.json.origin} → ${f.json.destination}\nDeparture:  ${f.json.departure_time}\nCapacity:   ${f.json.booked_seats}/${f.json.total_capacity} seats\nLoad Factor:${f.json.load_factor}\nRevenue:    ${f.json.total_revenue}\n----------------------------------`;\n});\n\nreturn [{\n  json: {\n    report: tableRows,\n    generated_at: new Date().toISOString(),\n    total_flights: flights.length\n  }\n}];"
            },
